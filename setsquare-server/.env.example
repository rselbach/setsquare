# Server secrets stay out of VITE_ variables and frontend builds.
DATABASE_URL=postgresql://localhost/setsquare
APP_ORIGIN=http://localhost:3001
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Numeric GitHub user ids that may sign in, comma-separated. Production requires
# this or ALLOW_ANY_GITHUB_ACCOUNT=true. Development admits any account without it.
# ALLOWED_GITHUB_IDS=
PORT=3002
HOST=127.0.0.1
# Optional additional browser origins for MCP, comma-separated and without paths.
# Native/server MCP clients do not need this setting.
# MCP_ALLOWED_ORIGINS=https://your-client.example
