{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Setsquare",
  "identifier": "com.setsquare.desktop",
  "build": {
    "beforeDevCommand": "yarn vite",
    "devUrl": "http://localhost:3001",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Setsquare",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "worker-src": "'self'",
        "frame-src": "https://youtube.com https://www.youtube.com https://youtu.be https://www.youtu.be https://vimeo.com https://www.vimeo.com https://player.vimeo.com https://drive.google.com https://figma.com https://www.figma.com https://*.simplepdf.eu https://stackblitz.com https://www.stackblitz.com https://val.town https://www.val.town https://giphy.com https://www.giphy.com https://forms.microsoft.com",
        "object-src": "'none'",
        "base-uri": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "icon": ["icons/icon.png", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["setsquare"],
        "name": "Setsquare Drawing",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/vnd.setsquare+json",
        "exportedType": {
          "identifier": "com.setsquare.drawing",
          "conformsTo": ["public.json"]
        }
      },
      {
        "ext": ["setsquarelib"],
        "name": "Setsquare Library",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/vnd.setsquarelib+json",
        "exportedType": {
          "identifier": "com.setsquare.library",
          "conformsTo": ["public.json"]
        }
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3QzBDRUQ0NDk5RkZENjgKUldSby9aOUoxTTdBdDF2dzVJK2RzOEJPaTg2ajU5RFRTUXNXY3JBYXRnazM5TlNqTU5HenlOU1QK",
      "endpoints": ["https://github.com/rselbach/setsquare/releases/latest/download/latest.json"],
      "requireSignedVersion": true
    }
  }
}
