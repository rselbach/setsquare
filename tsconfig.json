{
  "compilerOptions": {
    "rootDir": "./",
    "target": "ESNext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": ["vitest/globals", "@testing-library/jest-dom"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@setsquare/common": ["./packages/common/src/index.ts"],
      "@setsquare/common/*": ["./packages/common/src/*"],
      "@setsquare/setsquare": ["./packages/setsquare/index.tsx"],
      "@setsquare/setsquare/*": ["./packages/setsquare/*"],
      "@setsquare/element": ["./packages/element/src/index.ts"],
      "@setsquare/element/*": ["./packages/element/src/*"],
      "@setsquare/fractional-indexing": ["./packages/fractional-indexing/src/index.ts"],
      "@setsquare/fractional-indexing/*": ["./packages/fractional-indexing/src/*"],
      "@setsquare/laser-pointer": ["./packages/laser-pointer/src/index.ts"],
      "@setsquare/laser-pointer/*": ["./packages/laser-pointer/src/*"],
      "@setsquare/math": ["./packages/math/src/index.ts"],
      "@setsquare/math/*": ["./packages/math/src/*"],
      "@setsquare/mermaid-to-setsquare": ["./packages/mermaid-to-setsquare/src/index.ts"],
      "@setsquare/mermaid-to-setsquare/*": ["./packages/mermaid-to-setsquare/src/*"],
      "@setsquare/utils": ["./packages/utils/src/index.ts"],
      "@setsquare/utils/*": ["./packages/utils/src/*"]
    }
  },
  "include": ["packages", "setsquare-app"],
  "exclude": ["examples", "dist", "types", "tests", "setsquare-app/src-tauri"]
}
