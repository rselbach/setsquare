{
  "private": true,
  "name": "setsquare-monorepo",
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "setsquare-app",
    "setsquare-server",
    "packages/*",
    "examples/*"
  ],
  "devDependencies": {
    "@babel/preset-env": "7.26.9",
    "@types/lodash.throttle": "4.1.7",
    "@types/node": "20.17.22",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "3.2.7",
    "@vitest/ui": "3.2.7",
    "esbuild": "0.19.10",
    "esbuild-sass-plugin": "2.16.0",
    "eslint": "7.32.0",
    "eslint-config-prettier": "8.5.0",
    "eslint-config-react-app": "7.0.1",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-prettier": "3.3.1",
    "http-server": "14.1.1",
    "husky": "7.0.4",
    "jsdom": "26.1.0",
    "lint-staged": "12.3.7",
    "pepjs": "0.5.3",
    "prettier": "2.6.2",
    "rimraf": "^5.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-checker": "0.7.2",
    "vite-plugin-ejs": "1.7.0",
    "vite-plugin-pwa": "1.3.0",
    "vite-plugin-svgr": "4.5.0",
    "vitest": "3.2.7",
    "vitest-canvas-mock": "1.2.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "homepage": ".",
  "scripts": {
    "start:server": "yarn workspace setsquare-server dev",
    "build:server": "yarn workspace setsquare-server build",
    "serve": "yarn workspace setsquare-server start",
    "test:server": "yarn workspace setsquare-server test",
    "test:server:typecheck": "yarn workspace setsquare-server typecheck",
    "build:app:docker": "yarn --cwd ./setsquare-app build:app:docker",
    "build:app": "yarn --cwd ./setsquare-app build:app",
    "build:common": "yarn --cwd ./packages/common build:esm",
    "build:element": "yarn --cwd ./packages/element build:esm",
    "build:setsquare": "yarn --cwd ./packages/setsquare build:esm",
    "build:math": "yarn --cwd ./packages/math build:esm",
    "build:fractional-indexing": "yarn --cwd ./packages/fractional-indexing build:esm",
    "build:laser-pointer": "yarn --cwd ./packages/laser-pointer build:esm",
    "build:packages": "yarn build:common && yarn build:fractional-indexing && yarn build:laser-pointer && yarn build:math && yarn build:element && yarn build:setsquare",
    "build:version": "yarn --cwd ./setsquare-app build:version",
    "build": "yarn --cwd ./setsquare-app build",
    "build:preview": "yarn --cwd ./setsquare-app build:preview",
    "start": "yarn --cwd ./setsquare-app start",
    "start:production": "yarn --cwd ./setsquare-app start:production",
    "start:example": "yarn build:packages && yarn --cwd ./examples/with-script-in-browser start",
    "tauri": "yarn --cwd ./setsquare-app tauri",
    "test:all": "yarn test:typecheck && yarn test:server:typecheck && yarn test:code && yarn test:other && yarn test:app --watch=false && yarn test:server",
    "test:app": "vitest",
    "test:code": "eslint --max-warnings=0 --ext .js,.ts,.tsx .",
    "test:other": "yarn prettier --list-different",
    "test:typecheck": "tsc",
    "test:update": "yarn test:app --update --watch=false",
    "test": "yarn test:app",
    "test:coverage": "vitest --coverage",
    "test:coverage:watch": "vitest --coverage --watch",
    "test:ui": "yarn test --ui --coverage.enabled=true",
    "fix:code": "yarn test:code --fix",
    "fix:other": "yarn prettier --write",
    "fix": "yarn fix:other && yarn fix:code",
    "locales-coverage": "node scripts/build-locales-coverage.js",
    "prepare": "husky install",
    "prettier": "prettier \"**/*.{css,scss,json,md,html,yml}\" --ignore-path=.eslintignore",
    "rm:build": "rimraf --glob setsquare-app/build setsquare-app/dist setsquare-app/dev-dist packages/*/dist packages/*/build examples/*/build examples/*/dist",
    "rm:node_modules": "rimraf --glob node_modules setsquare-app/node_modules packages/*/node_modules",
    "clean-install": "yarn rm:node_modules && yarn install"
  },
  "resolutions": {
    "strip-ansi": "6.0.1"
  }
}
