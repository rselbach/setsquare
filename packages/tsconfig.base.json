{
  "compilerOptions": {
    "target": "ESNext",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "allowSyntheticDefaultImports": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "emitDeclarationOnly": true,
    "paths": {
      "@setsquare/common": ["./common/src/index.ts"],
      "@setsquare/common/*": ["./common/src/*"],
      "@setsquare/element": ["./element/src/index.ts"],
      "@setsquare/element/*": ["./element/src/*"],
      "@setsquare/setsquare": ["./setsquare/index.tsx"],
      "@setsquare/setsquare/*": ["./setsquare/*"],
      "@setsquare/laser-pointer": ["./laser-pointer/src/index.ts"],
      "@setsquare/laser-pointer/*": ["./laser-pointer/src/*"],
      "@setsquare/math": ["./math/src/index.ts"],
      "@setsquare/math/*": ["./math/src/*"],
      "@setsquare/mermaid-to-setsquare": ["./mermaid-to-setsquare/src/index.ts"],
      "@setsquare/mermaid-to-setsquare/*": ["./mermaid-to-setsquare/src/*"],
      "@setsquare/utils": ["./utils/src/index.ts"],
      "@setsquare/utils/*": ["./utils/src/*"],
      "@setsquare/fractional-indexing": ["./fractional-indexing/src/index.ts"],
      "@setsquare/fractional-indexing/*": ["./fractional-indexing/src/*"]
    }
  }
}
